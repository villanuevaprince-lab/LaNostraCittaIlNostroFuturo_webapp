# Copia questo file in .env e sostituisci i segnaposto. Non committare mai .env.
SECRET_KEY=INSERISCI_UNA_STRINGA_CASUALE_DI_ALMENO_32_CARATTERI
SESSION_COOKIE_SECURE=false
RATELIMIT_STORAGE_URI=memory://
UPLOAD_FOLDER=storage/uploads
MAP_CONTACT_EMAIL=tuo-email@example.com

DB_HOST=il-tuo-host.aivencloud.com
DB_PORT=12345
DB_POOL_SIZE=5
# Secondi di attesa di una connessione libera quando il pool è tutto occupato (0-30).
DB_POOL_WAIT=5
DB_USER=avnadmin
DB_PASSWORD=la-password-di-aiven
DB_NAME=nostra_citta
# Contenuto del certificato CA Aiven (una riga, con \n al posto degli a capo).
DB_SSL_CA=-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----

# IA locale con Ollama. AI_ENABLED=true: ogni nuovo contenuto passa dalla verifica AI
# prima della pubblicazione (coda su MySQL + worker: flask --app backend.app verifica-worker).
# AI_ENABLED=false: pubblicazione immediata come prima, senza verifica.
AI_ENABLED=true
OLLAMA_URL=http://localhost:11434
# Suggerimento categorie nel form (testo).
OLLAMA_TEXT_MODEL=qwen2.5:7b
OLLAMA_TIMEOUT_TEXT=20
OLLAMA_VISION_MODEL=qwen2.5vl:7b
# Verifica prima della pubblicazione: modello multimodale (default = OLLAMA_VISION_MODEL).
VERIFICA_MODELLO=qwen2.5vl:7b
VERIFICA_TIMEOUT=120
# Rifiuto automatico solo con gravità 3 e confidenza >= soglia alta;
# pubblicazione automatica solo senza violazioni (o gravità 1) e confidenza >= soglia bassa.
VERIFICA_SOGLIA_ALTA=0.90
VERIFICA_SOGLIA_BASSA=0.70
# Errori transitori: tentativi, backoff esponenziale (secondi, base e tetto).
VERIFICA_MAX_TENTATIVI=5
VERIFICA_BACKOFF_BASE=30
VERIFICA_BACKOFF_MAX=3600
# Attesa del worker con coda vuota o modello assente; lease di un job orfano (secondi).
VERIFICA_INTERVALLO=10
VERIFICA_LEASE_SECONDI=900
# Reinvii consentiti dopo un rifiuto automatico.
VERIFICA_MAX_REINVII=3

# Email (reset password e cambio indirizzo). Senza MAIL_SERVER le email vengono salvate
# come file .eml in MAIL_OUTBOX_DIR (solo sviluppo). Valori segnaposto: non usare credenziali reali qui.
MAIL_SERVER=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_USE_TLS=true
MAIL_USE_SSL=false
MAIL_FROM=La Nostra Città <noreply@tuodominio.example>
MAIL_OUTBOX_DIR=storage/mail_outbox
# Indirizzo pubblico dell'app, usato nei link inviati per email (mai dedotto dalla richiesta).
APP_BASE_URL=http://localhost:3000
# Durata dei link in secondi: reset password (30 min) e conferma nuova email (60 min).
PASSWORD_RESET_MAX_AGE=1800
EMAIL_CHANGE_MAX_AGE=3600
