# Valori ammessi: demo, database
APP_MODE=demo
PORT=5000
FLASK_DEBUG=1

# Connessione MySQL Aiven, usata solo con APP_MODE=database
DB_HOST=mysql-project-name.aivencloud.com
DB_PORT=12345
DB_USER=avnadmin
DB_PASSWORD=replace-with-your-password
DB_NAME=nostra_citta

# Percorso facoltativo del certificato CA
DB_SSL_CA_PATH=certificates/ca.pem
