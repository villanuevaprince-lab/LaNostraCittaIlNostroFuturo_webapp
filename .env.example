# Valori ammessi: demo, database
APP_MODE=database
PORT=11562
FLASK_DEBUG=0
HOST=villanueva-mysql-193ed9ed-iisgalvanimi-5b00.b.aivencloud.com

# Genera con: python -c "import secrets; print(secrets.token_hex(32))"
# Obbligatoria in modalità database; la demo può usare una chiave effimera.
SECRET_KEY=una_stringa_di_32_caratteri_da_generare_con_secrets_token_hex
# Imposta true quando l'app è servita tramite HTTPS.
SESSION_COOKIE_SECURE=false
# Solo sviluppo monoprocesso; in produzione usa uno storage condiviso.
RATELIMIT_STORAGE_URI=memory://
UPLOAD_FOLDER=storage/uploads

# Inserisci i valori della pagina di connessione del tuo servizio Aiven.
DB_HOST=villanueva-mysql-193ed9ed-iisgalvanimi-5b00.b.aivencloud.com
DB_PORT=11562
DB_POOL_SIZE=5
DB_USER=avnadmin
DB_PASSWORD=replace-with-your-password
DB_NAME=nostra_citta

# Certificato CA obbligatorio in modalità database (verifica TLS attiva)
DB_SSL_CA_PATH=certificates/ca.pem
