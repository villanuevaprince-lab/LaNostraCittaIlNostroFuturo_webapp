NODE_ENV=development
PORT=3000
APP_BASE_URL=http://127.0.0.1:3000
TRUST_PROXY=false

# Connessione MySQL Aiven
DB_HOST=mysql-project-name.aivencloud.com
DB_PORT=12345
DB_USER=avnadmin
DB_PASSWORD=replace-with-your-password
DB_NAME=nostra_citta

# Valori ammessi: verify-ca, required, disabled
DB_SSL_MODE=verify-ca
# Copia il certificato CA di Aiven in certificates/ca.pem.
DB_SSL_CA_PATH=certificates/ca.pem

# Genera almeno 32 byte casuali. Non riusare il valore di esempio.
SESSION_SECRET=replace-with-at-least-32-random-characters
SESSION_COOKIE_NAME=nostra_citta.sid
SESSION_MAX_AGE_MS=28800000

STORAGE_DIR=storage/uploads
MAX_UPLOAD_BYTES=12582912
