PORT=5000
FLASK_DEBUG=0
HOST=127.0.0.1

# Genera con: python -c "import secrets; print(secrets.token_hex(32))"
# Obbligatoria: usa sempre la stessa chiave fra riavvii e istanze.
SECRET_KEY=
# Imposta true quando l'app è servita tramite HTTPS.
SESSION_COOKIE_SECURE=false
# Solo sviluppo monoprocesso; in produzione usa uno storage condiviso.
RATELIMIT_STORAGE_URI=memory://
UPLOAD_FOLDER=storage/uploads

# Inserisci i valori della pagina di connessione del tuo servizio Aiven.
DB_HOST=replace-with-aiven-host
DB_PORT=3306
DB_POOL_SIZE=5
DB_USER=replace-with-aiven-user
DB_PASSWORD=replace-with-your-password
DB_NAME=nostra_citta

# Certificato CA obbligatorio per MySQL (verifica TLS attiva)
DB_SSL_CA_PATH=certificates/ca.pem
